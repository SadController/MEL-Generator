{
  "name": "mel-generator",
  "productName": "MEL Generator",
  "version": "1.0.0",
  "description": "Offline MMEL scenario generator for Fenix A320 Family flight simulation",
  "author": "MEL Generator Project",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build": "electron-builder --win portable nsis --x64",
    "prepare-data": "node scripts/prepare-data.cjs"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.melgenerator.desktop",
    "asar": true,
    "electronLanguages": ["en-US"],
    "directories": { "output": "release", "buildResources": "resources" },
    "files": ["desktop/**", "core/**", "ui/**", "data/**", "package.json"],
    "extraResources": [{ "from": "resources/MMEL.pdf", "to": "MMEL.pdf" }, { "from": "resources/THIRD-PARTY-NOTICES.txt", "to": "THIRD-PARTY-NOTICES.txt" }],
    "win": { "target": ["portable", "nsis"], "icon": "resources/icon.ico", "signAndEditExecutable": true },
    "portable": { "artifactName": "MEL-Generator-${version}-portable.exe" },
    "nsis": { "artifactName": "MEL-Generator-Setup-${version}.exe", "oneClick": false, "perMachine": false, "allowElevation": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": false, "createStartMenuShortcut": true, "runAfterFinish": false, "deleteAppDataOnUninstall": false, "installerLanguages": ["en_US"] }
  }
}
